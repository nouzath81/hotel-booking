<h1>New Booking</h1>
<div class="card">
  <form method="post" action="/bookings">
    <div class="formgrid">
      <p><label>Customer name *</label><input class="input" name="customer_name" required></p>
      <p><label>Phone No. / WhatsApp No.</label><input class="input" name="phone" id="phone" type="tel" placeholder="0771234567" autocomplete="tel"><span class="small">WhatsApp number is created automatically from this phone number.</span><div id="waPreview" class="small"></div></p>
      <p><label>Email</label><input class="input" name="email" type="email"></p>
      <p><label>Address</label><input class="input" name="address"></p>
      <p><label>Room type *</label><select class="input" name="room_type" id="room_type" required><option value="">Select</option><% types.forEach(function(t){ %><option value="<%= t.type_name %>" data-rate="<%= t.default_rate %>"><%= t.type_name %> - <%= money(t.default_rate) %></option><% }); %></select></p>
      <p><label>Available Room No(s)</label><select class="input" id="room_selector" multiple size="4"><option>Select room type and dates first</option></select><span class="small">Only rooms assigned to the selected room type are shown. Booked rooms are removed automatically.</span></p>
      <p><label>Room No(s) selected</label><input class="input" name="room_no" id="room_no" placeholder="101,102" readonly></p>
      <p><label>Room count</label><input class="input" type="number" name="room_count" id="room_count" value="1" min="1" readonly></p>
      <p><label>Check-in *</label><input class="input" type="date" name="checkin_date" id="checkin_date" required></p>
      <p><label>Check-out *</label><input class="input" type="date" name="checkout_date" id="checkout_date" required></p>
      <p><label>Days / Nights</label><input class="input" type="number" name="nights_display" id="nights_display" value="1" readonly></p>
      <p><label>Rate / night</label><input class="input" type="number" step=".01" name="rate_per_night" id="rate_per_night" value="0"></p>
      <p><label>Extra charges</label><input class="input" type="number" step=".01" name="extra_charges" id="extra_charges" value="0"></p>
      <p><label>Discount</label><input class="input" type="number" step=".01" name="discount" id="discount" value="0"></p>
      <p><label>Tax %</label><input class="input" type="number" step=".01" name="tax_percent" id="tax_percent" value="0"></p>
      <p><label>Advance Pay</label><input class="input" type="number" step=".01" name="advance_paid" id="advance_paid" value="0"></p>
      <p><label>Booking Total</label><input class="input" id="booking_total" value="0.00" readonly></p>
      <p><label>Balance Due</label><input class="input" id="balance_due" value="0.00" readonly></p>
      <p><label>Status</label><select class="input" name="status"><option>Confirmed</option><option>Pending</option><option>Checked-In</option><option>Checked-Out</option><option>Cancelled</option></select></p>
      <p style="grid-column:1/-1"><label>Notes</label><textarea class="input" name="notes"></textarea></p>
    </div>
    <div id="availabilityMsg" class="small" style="margin:4px 0 12px"></div>
    <button type="submit">Create Booking</button>
  </form>
</div>
<script>
(function(){
 const phone=document.getElementById('phone'),waPreview=document.getElementById('waPreview');
 const ci=document.getElementById('checkin_date'),co=document.getElementById('checkout_date'),n=document.getElementById('nights_display');
 const type=document.getElementById('room_type'),rate=document.getElementById('rate_per_night'),extra=document.getElementById('extra_charges'),discount=document.getElementById('discount'),tax=document.getElementById('tax_percent'),advance=document.getElementById('advance_paid'),total=document.getElementById('booking_total'),balance=document.getElementById('balance_due');
 const selector=document.getElementById('room_selector'),roomNo=document.getElementById('room_no'),roomCount=document.getElementById('room_count'),msg=document.getElementById('availabilityMsg');
 function calc(){if(ci.value&&co.value){const a=new Date(ci.value+'T00:00:00'),b=new Date(co.value+'T00:00:00');n.value=(b>a?Math.ceil((b-a)/86400000):1);}const nights=Number(n.value||1),base=nights*Number(rate.value||0)+Number(extra.value||0)-Number(discount.value||0),grand=Math.max(0,base*(1+Number(tax.value||0)/100));total.value=grand.toFixed(2);balance.value=Math.max(0,grand-Number(advance.value||0)).toFixed(2);}
 function selected(){return [...selector.selectedOptions].map(o=>o.value).filter(Boolean)}
 selector.addEventListener('change',()=>{const a=selected();roomNo.value=a.join(', ');roomCount.value=Math.max(1,a.length);msg.textContent=a.length?a.length+' room(s) selected.':'';});
 async function loadRooms(){if(!type.value||!ci.value||!co.value||new Date(co.value)<=new Date(ci.value)){selector.innerHTML='<option>Select room type and valid dates first</option>';roomNo.value='';roomCount.value=1;return;}selector.innerHTML='<option>Loading...</option>';try{const r=await fetch('/api/availability?room_type='+encodeURIComponent(type.value)+'&checkin='+encodeURIComponent(ci.value)+'&checkout='+encodeURIComponent(co.value),{cache:'no-store'});const d=await r.json();selector.innerHTML='';(d.available||[]).forEach(x=>{const o=document.createElement('option');o.value=x;o.textContent='Room '+x+' — Available';selector.appendChild(o)});if(!d.available?.length)selector.innerHTML='<option>No rooms available</option>';msg.textContent='Available '+(d.available||[]).length+' room(s) for '+type.value+'.';}catch(e){selector.innerHTML='<option>Availability unavailable</option>';msg.textContent='Could not load room availability.';}}
 type.addEventListener('change',()=>{const opt=type.options[type.selectedIndex];rate.value=opt.dataset.rate||0;calc();loadRooms()});[ci,co].forEach(x=>x.addEventListener('change',()=>{calc();loadRooms()}));[rate,extra,discount,tax,advance].forEach(x=>x.addEventListener('input',calc));
 function updateWhatsApp(){let s=String(phone.value||'').replace(/\D/g,'');if(s.startsWith('00'))s=s.slice(2);if(s.startsWith('0'))s='94'+s.slice(1);waPreview.textContent=s?'Automatic WhatsApp No.: +'+s:'WhatsApp No. will be generated automatically';} phone.addEventListener('input',updateWhatsApp);updateWhatsApp();calc();
})();
</script>
