<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body{font-family:Arial,sans-serif;margin:0;background:#f5f7fb;color:#172033}
    .top{background:#152238;color:#fff;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
    .top a{color:#fff;text-decoration:none;margin:0 7px}
    .wrap{max-width:1200px;margin:22px auto;padding:0 15px}
    .card{background:#fff;border-radius:12px;padding:18px;margin-bottom:18px;box-shadow:0 2px 10px #0001}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
    .stat{font-size:28px;font-weight:bold}
    .btn,button{background:#1769e0;color:#fff;border:0;padding:9px 13px;border-radius:7px;text-decoration:none;cursor:pointer}
    .danger{background:#c62828}
    .input,select,textarea{padding:9px;width:100%;box-sizing:border-box;border:1px solid #ccd3df;border-radius:6px}
    .formgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
    .table{width:100%;border-collapse:collapse}
    .table th,.table td{padding:9px;border-bottom:1px solid #e5e8ee;text-align:left}
    .small{color:#667085;font-size:13px}
    .login{max-width:420px;margin:70px auto}
    .nav{display:flex;flex-wrap:wrap;gap:6px}
    .nav a{font-size:14px}
  </style>
</head>
<body>
  <% if (locals.user) { %>
    <div class="top">
      <div><b>Hotel Booking System</b></div>
      <div class="nav">
        <a href="/">Dashboard</a>
        <a href="/bookings">Bookings</a>
        <a href="/rooms">Rooms</a>
        <a href="/payments">Payments</a>
        <a href="/petty-cash">Petty Cash</a>
        <a href="/pos">POS</a>
        <a href="/pos/products">Products</a>
        <a href="/reports">Reports</a>
        <% if (locals.user.role === 'admin') { %>
          <a href="/settings">Settings</a>
        <% } %>
        <a href="/logout">Logout</a>
      </div>
    </div>
  <% } %>

  <div class="wrap">
    <% if (locals.error) { %>
      <div class="card" style="border-left:4px solid #c62828"><%= locals.error %></div>
    <% } %>
    <%- include(content) %>
  </div>
</body>
</html>
